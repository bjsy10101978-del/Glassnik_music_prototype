{
  "name": "glassnik-music-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Glassnik music recommendation and continuous playback research prototype.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
