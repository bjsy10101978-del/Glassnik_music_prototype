    "build:data": "node scripts/build-data.mjs",
    "verify:audio": "node scripts/verify-audio.mjs",
    "licence:csv": "node scripts/licence-review-csv.mjs",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "mpg123-decoder": "^1.0.3",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
